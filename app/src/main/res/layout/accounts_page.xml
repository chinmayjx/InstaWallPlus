<?xml version="1.0" encoding="utf-8"?>
<!-- every account, with add, open and log out -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accounts_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/accounts_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="Close"
        app:navigationIcon="@drawable/ic_close"
        app:title="Accounts" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/InstaWall.SectionHeader"
                android:text="Instagram" />

            <LinearLayout
                android:id="@+id/instagram_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_instagram"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Instagram account"
                app:icon="@drawable/ic_person_add" />

            <TextView
                style="@style/InstaWall.SectionHeader"
                android:text="Reddit" />

            <LinearLayout
                android:id="@+id/reddit_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_reddit"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Reddit account"
                app:icon="@drawable/ic_person_add" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
