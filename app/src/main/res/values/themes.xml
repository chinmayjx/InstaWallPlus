<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- always dark, the photos are the UI -->
    <style name="Theme.InstaWall" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/iw_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/iw_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/iw_accent</item>
        <item name="colorSecondaryContainer">@color/iw_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:colorBackground">@color/iw_background</item>
        <item name="colorSurface">@color/iw_surface</item>
        <item name="colorSurfaceContainer">@color/iw_surface</item>
        <item name="colorSurfaceContainerHigh">@color/iw_surface_high</item>
        <item name="colorOnSurface">@color/iw_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/iw_on_surface_dim</item>
        <item name="colorOutline">@color/iw_outline</item>
        <item name="android:statusBarColor">@color/iw_background</item>
        <item name="android:navigationBarColor">@color/iw_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.InstaWall.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_900</item>
        <item name="fullscreenTextColor">@color/light_blue_A400</item>
    </style>

    <style name="ShapeAppearance.InstaWall.Tile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.InstaWall.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>
